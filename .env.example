# ============================================================
# Variables de entorno de GameStats AI
# Copia este archivo como .env y cambia los valores.
# El archivo .env NUNCA se sube a GitHub (esta en .gitignore).
# Si una variable no existe, la app usa el valor por defecto de application.yml.
# ============================================================

# --- Base de datos (PostgreSQL + pgvector en Docker) ---
DB_URL=jdbc:postgresql://localhost:5440/gamestats_rag?stringtype=unspecified
DB_USERNAME=admin
DB_PASSWORD=cambia-esta-contrasena

# --- JWT ---
# Clave para firmar los tokens. Minimo 32 caracteres, larga y aleatoria.
JWT_SECRET=pon-aqui-una-clave-larga-y-aleatoria-de-al-menos-32-caracteres
# Duracion del token en milisegundos (86400000 = 24 horas)
JWT_EXPIRATION=86400000

# --- Ollama (IA local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_LLM_MODEL=llama3.2:3b

# --- RAG ---
# Similitud minima (0 a 1) para usar un fragmento como fuente
RAG_MIN_SIMILARITY=0.40
