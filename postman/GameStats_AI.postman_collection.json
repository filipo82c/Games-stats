    },
    {
      "name": "6. Dashboard",
      "item": [
        {
          "name": "Dashboard (ultimos 30 dias)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test(\"Trae el resumen\", () => pm.expect(d.resumen).to.have.property(\"totalConsultas\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Indicadores calculados con SQL. Compara los numeros con docs/consultas_dashboard.sql.",
            "url": {
              "raw": "{{baseUrl}}/api/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboard"
              ],
              "query": []
            }
          }
        },
        {
          "name": "Dashboard con filtros",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test(\"Trae el resumen\", () => pm.expect(d.resumen).to.have.property(\"totalConsultas\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "description": "Filtra por rango de fechas y por juego.",
            "url": {
              "raw": "{{baseUrl}}/api/dashboard?desde=2026-11-01&hasta=2026-11-30&juegoId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "dashboard"
              ],
              "query": [
                {
                  "key": "desde",
                  "value": "2026-11-01"
                },
                {
                  "key": "hasta",
                  "value": "2026-11-30"
                },
                {
                  "key": "juegoId",
                  "value": "1"
                }
              ]
            }
          }
        },
