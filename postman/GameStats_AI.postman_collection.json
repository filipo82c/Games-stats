    {
      "name": "5. Historial y calificación",
      "item": [
        {
          "name": "Historial de consultas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/consultas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "consultas"
              ]
            },
            "description": "Lista las consultas del usuario, la mas reciente primero, con su estado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle de una consulta",
          "request": {
